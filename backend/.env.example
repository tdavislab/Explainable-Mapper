# Backend environment variables
# Copy this file to `.env` and fill in YOUR OWN values:
#   cp .env.example .env
#
# This repository does NOT ship a real OpenAI API key.
# You must create a key at https://platform.openai.com/api-keys
# and paste it below.
#
# Never commit your real `.env` file.

# Required for LLM explanations, trajectory generation, and highlight-changes
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override Flask session signing key (set a strong value for any shared/public deployment)
# FLASK_SECRET_KEY=replace-with-a-long-random-string

# Optional: set to 0 to disable Flask debug mode
# FLASK_DEBUG=1
